{
  "expo": {
    "name": "OutfitSpin",
    "slug": "outfitspin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "outfitspin",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "OutfitSpin uses the camera to photograph your clothes and your fit pics.",
        "NSPhotoLibraryUsageDescription": "OutfitSpin lets you pick clothing photos from your library.",
        "NSLocationWhenInUseUsageDescription": "OutfitSpin checks the weather where you are to pick outfits that match the day."
      },
      "bundleIdentifier": "com.outfitspin.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF6FB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.outfitspin.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF6FB",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OutfitSpin checks the weather where you are to pick outfits that match the day."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
